+                . "Content-Transfer-Encoding: base64\r\n"
+                . 'Content-Disposition: attachment; filename="' . $name . "\"\r\n\r\n"
+                . $b64;
+        }
+        $parts .= '--' . $bound . "--\r\n";
+        return $dot($parts) . '.';
