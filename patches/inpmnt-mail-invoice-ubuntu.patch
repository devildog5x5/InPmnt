+                'svg' => 'image/svg+xml',
+                'ico' => 'image/x-icon',
+                'webp' => 'image/webp',
+            ];
+            header('Content-Type: ' . ($types[$ext] ?? 'application/octet-stream'));
+            if (in_array($ext, ['js', 'css'], true)) {
+                header('Cache-Control: public, max-age=60, must-revalidate');
+            } else {
+                header('Cache-Control: public, max-age=86400');
+            }
+            readfile($file);
+            exit;
+        }
+    }
+}
+
+(new App($db))->run();
