+    /** @return list<string> */
+    private static function wrap(string $text, int $width): array
+    {
+        $words = preg_split('/\s+/', trim(str_replace(["\r", "\n"], ' ', $text))) ?: [];
+        $lines = [];
+        $cur = '';
+        foreach ($words as $word) {
+            $trial = trim($cur . ' ' . $word);
+            if (strlen($trial) <= $width) {
+                $cur = $trial;
+            } else {
+                if ($cur !== '') {
+                    $lines[] = $cur;
+                }
+                $cur = $word;
+            }
+        }
+        if ($cur !== '') {
+            $lines[] = $cur;
+        }
+        return $lines ?: [''];
+    }
