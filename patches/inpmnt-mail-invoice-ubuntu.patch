+    private static function esc(string $text): string
+    {
+        $text = str_replace(["\r", "\n"], ' ', $text);
+        $out = '';
+        $chars = preg_split('//u', $text, -1, PREG_SPLIT_NO_EMPTY) ?: [];
+        foreach ($chars as $ch) {
+            if ($ch === '\\' || $ch === '(' || $ch === ')') {
+                $out .= '\\' . $ch;
+                continue;
+            }
+            if ($ch === "\u{00B7}") {
+                $out .= "\xB7";
+                continue;
+            }
+            if ($ch === "\u{2014}") {
+                $out .= "\x97";
+                continue;
+            }
+            if (strlen($ch) === 1) {
+                $o = ord($ch);
+                $out .= ($o >= 32 && $o <= 126) ? $ch : '?';
+            } else {
+                $out .= '?';
+            }
+        }
+        return $out;
+    }
