OURCIRCLE_SECRET=change-me
OURCIRCLE_HOST=127.0.0.1
OURCIRCLE_PORT=5065
OURCIRCLE_SITE_URL=https://familyshieldpro.com
# BASE_URL=http://127.0.0.1:5065
# OURCIRCLE_DB=data/ourcircle.db

# Stripe — paste real values from https://dashboard.stripe.com (see STRIPE.md)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# Mail for password-reset and circle-invite links (see AUTH.md)
# SMTP_PASSWORD is required. Do not wrap values in quotes.
MAIL_FROM=hello@familyshieldpro.com
MAIL_FROM_NAME=Family Shield Pro
# RESEND_API_KEY=re_...
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SSL=1
# SMTP_USER=hello@familyshieldpro.com
# SMTP_PASSWORD=

# Customer service (see SUPPORT.md)
# SUPPORT_PHONE=
# Optional AI for the Chat with us widget. FAQ answers work without this.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# SMS — optional Twilio (see SMS.md). Stubs with ... stay off.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM=+1...

# Operator console — see ADMIN.md. Off until set. Stubs with ... stay off. 12+ characters.
# ADMIN_PASSWORD=change-me-to-a-long-...
# ADMIN_EMAIL=Customer_Service@familyshieldpro.com
