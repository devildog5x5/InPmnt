# Copy to .env and fill in. Never commit .env.

FLASK_SECRET_KEY=change-me-to-a-long-random-string
BASE_URL=https://127.0.0.1:5055

# SQLite path (Docker sets /app/data/inpmnt.db). Leave blank for ./inpmnt.db
# DATABASE_PATH=/app/data/inpmnt.db

# Local HTTPS (self-signed cert in certs/). Set USE_HTTPS=0 for plain HTTP.
USE_HTTPS=1
# Optional: use your own PEM files instead of certs/localhost*.pem
# SSL_CERT_FILE=C:\path\to\fullchain.pem
# SSL_KEY_FILE=C:\path\to\privkey.pem
# Regenerate self-signed:  .\.venv\Scripts\python.exe -m app.local_ssl --force

# Show demouser / Demo on login (local only). Leave off in production.
SHOW_DEMO_LOGIN=0
# Allow reminder "send" without real email (marks sent + logs only).
ALLOW_FAKE_EMAIL=0

# Email — Resend (preferred) or SMTP. Used for invoice reminders and password reset.
# RESEND_API_KEY=re_...
MAIL_FROM=billing@yourdomain.com
MAIL_FROM_NAME=InvoicePay
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SSL=0
# SMTP_STARTTLS=1

# Stripe (https://dashboard.stripe.com/apikeys)
# Checkout stays off until the secret key and both new price IDs look real
# (prefix sk_ / price_, longer than the placeholders below).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# New prices Robert creates on a product named "InvoicePay".
# Statement descriptor is set on that Stripe product (suggested: INVOICEPAY), not in this file.
# STRIPE_PRICE_MONTHLY = $4.99 USD, recurring, every month
# STRIPE_PRICE_YEARLY  = $49.99 USD, recurring, every year
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# Legacy price IDs. Leave these only if existing subscribers are still on the old
# prices so webhooks can tell starter / pro / annual apart. Do not paste the new
# $4.99 or $49.99 price IDs here. They are not offered at checkout.
# STRIPE_PRICE_STARTER was $10/month. STRIPE_PRICE_PRO was $20/month.
# STRIPE_PRICE_ANNUAL was $100/year.
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ANNUAL=price_...

# Optional search-console verification. Leave empty (default) until you have a code.
GOOGLE_SITE_VERIFICATION=
MSVALIDATE_01=

# Optional Help tab (simple FAQ always; Grok when keyed)
# SUPPORT_EMAIL=support@invcpay.com
# XAI_API_KEY=xai-...
# GROK_API_KEY=xai-...
# GROK_MODEL=grok-4.6
