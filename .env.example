# Copy to .env and fill in. Never commit .env.

FLASK_SECRET_KEY=change-me-to-a-long-random-string
BASE_URL=https://127.0.0.1:5055

# SQLite path (Docker sets /app/data/inpmnt.db). Leave blank for ./inpmnt.db
# DATABASE_PATH=/app/data/inpmnt.db

# Local HTTPS (self-signed cert in certs/). Set USE_HTTPS=0 for plain HTTP.
USE_HTTPS=1
# Optional: use your own PEM files instead of certs/localhost*.pem
# SSL_CERT_FILE=C:\path\to\fullchain.pem
# SSL_KEY_FILE=C:\path\to\privkey.pem
# Regenerate self-signed:  .\.venv\Scripts\python.exe -m app.local_ssl --force

# Show trialuser / LIfeMadeUSMCForged100! on login (local only). Leave off in production.
SHOW_DEMO_LOGIN=0
# Allow reminder "send" without real email (marks sent + logs only).
ALLOW_FAKE_EMAIL=0

# Email — Resend (preferred) or SMTP
# RESEND_API_KEY=re_...
MAIL_FROM=billing@yourdomain.com
MAIL_FROM_NAME=InPmnt
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SSL=0
# SMTP_STARTTLS=1

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs from Stripe Products (recurring)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ANNUAL=price_...
