<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS site physical path can point at this folder (deploy/iis).
  Requires: URL Rewrite + Application Request Routing (ARR) with proxy enabled.
  Proxies public HTTPS traffic to Waitress on 127.0.0.1:5055.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="InPmnt Reverse Proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:5055/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="20971520" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
