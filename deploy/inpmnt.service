[Unit]
Description=InPmnt (Gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/inpmnt
EnvironmentFile=/var/www/inpmnt/.env
ExecStart=/var/www/inpmnt/.venv/bin/gunicorn -b 127.0.0.1:5055 -w 2 --timeout 120 "run:app"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
