RewriteEngine On
RewriteBase /

# Hide the PHP banner where the host honors mod_headers / php_flag.
<IfModule mod_headers.c>
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>
<IfModule mod_php.c>
  php_flag expose_php Off
</IfModule>
<IfModule mod_php8.c>
  php_flag expose_php Off
</IfModule>
<IfModule lsapi_module>
  php_flag expose_php Off
</IfModule>

# One public URL: https://invcpay.com (no www, no trailing slash, no index.php).
RewriteCond %{HTTP_HOST} ^www\.invcpay\.com$ [NC]
RewriteRule ^ https://invcpay.com%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP:X-Forwarded-Proto} =http
RewriteCond %{HTTP_HOST} ^invcpay\.com$ [NC]
RewriteRule ^ https://invcpay.com%{REQUEST_URI} [R=301,L]

RewriteRule ^index\.php$ / [R=301,L,QSA]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L,QSA]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Never serve secrets, VCS metadata, dependency manifests, archives, or logs.
RewriteRule (?i)(^|/)\.(env|git|svn|hg)(/|$) - [F,L]
RewriteRule (?i)(^|/)(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml(\.dist)?)$ - [F,L]
RewriteRule (?i)^(\.env.*|bootstrap\.php)$ - [F,L]
RewriteRule ^(src|views|data|vendor|\.git)(/|$) - [F,L]
RewriteRule (?i)\.(db|sqlite|sqlite3|sql|zip|log|ini|ps1|sh|md|bak|yml|yaml|lock|dist|env)$ - [F,L]

<FilesMatch "(?i)^(composer\.(json|lock)|package(-lock)?\.json|\.env.*|\.gitignore|\.gitattributes|phpunit\.xml)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
<FilesMatch "(?i)\.(env|sql|zip|log|sqlite|sqlite3|db|bak|ps1|sh|md|ini)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

# Existing public files (CSS/JS/images) are served as-is
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteRule ^ index.php [QSA,L]
