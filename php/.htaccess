RewriteEngine On
DirectoryIndex index.php

# Do not set RewriteBase / — Hostinger File Manager often extracts the zip
# into a subfolder. RewriteBase / would send pretty URLs to the domain-root
# index.php, which is usually WordPress.

# Never serve secrets, PHP sources, or the SQLite file
RewriteRule ^(\.env|bootstrap\.php)$ - [F,L]
RewriteRule ^(src|views|data)(/|$) - [F,L]
RewriteRule \.db$ - [F,L]

# Existing public files (CSS/JS/images) are served as-is
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteRule ^ index.php [QSA,L]
