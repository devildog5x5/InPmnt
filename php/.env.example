# Copy to .env and fill in. Never commit .env.
# Hostinger: File Manager → public_html → upload this as .env

APP_SECRET=change-me-to-a-long-random-string
BASE_URL=https://yourdomain.com

# SQLite (default). File is created automatically under data/inpmnt.db
# DATABASE_PATH=data/inpmnt.db

SHOW_DEMO_LOGIN=0
ALLOW_FAKE_EMAIL=0

# Email — Resend (optional) or SMTP (Hostinger mailbox).
# If both are set, Resend is tried first and SMTP is the fallback.
# A dummy RESEND_API_KEY used to block SMTP entirely — that is fixed, but
# you can still force Hostinger SMTP with:
# MAIL_PROVIDER=smtp
#
# Hostinger mailbox (recommended on shared hosting):
# MAIL_FROM must be the same mailbox as SMTP_USER (exact address in hPanel).
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SSL=1
# SMTP_STARTTLS=0
#
# RESEND_API_KEY=re_...
MAIL_FROM=billing@yourdomain.com
MAIL_FROM_NAME=InPmnt
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=billing@yourdomain.com
# SMTP_PASSWORD=
# SMTP_SSL=1
# SMTP_STARTTLS=0

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ANNUAL=price_...
